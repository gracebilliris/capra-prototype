{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://capra.example/research/gamma/schemas/1.0.0",
  "schema_version": "1.0.0",
  "$defs": {
    "source_event": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_record_id", "source_system", "source_version", "adapter_id", "adapter_version", "trusted_source", "domain", "observed_at", "business_purpose", "context_owner_id", "payload"],
      "properties": {
        "source_record_id": {"type": "string", "minLength": 1},
        "source_system": {"type": "string", "minLength": 1},
        "source_version": {"type": "string", "minLength": 1},
        "adapter_id": {"type": "string", "minLength": 1},
        "adapter_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
        "trusted_source": {"type": "boolean"},
        "domain": {"type": "string", "enum": ["admissions", "healthcare", "retail", "environmental"]},
        "observed_at": {"type": "string", "format": "date-time"},
        "business_purpose": {"type": "string", "minLength": 1},
        "context_owner_id": {"type": "string", "minLength": 1},
        "payload": {"type": "object"}
      }
    },
    "context_record": {
      "type": "object",
      "required": ["context_record_id", "context_version_id", "version", "origin_event_id", "source_event_id", "domain", "context_owner_id", "observed_at", "ingested_at", "effective_from", "effective_to", "context_schema_version", "source_version", "provenance_method", "prov_was_derived_from", "business_purpose", "purpose_owner", "processing_location", "data_subject_location", "jurisdiction", "candidate_obligations", "applicability_basis", "applicability_status", "mapping_refs", "source_confidence", "transformation_confidence", "uncertainty_type", "uncertainty_note", "missing_context_fields", "validation_status", "validation_actor", "validation_time", "conflict", "conflict_assertions", "supersedes"],
      "properties": {
        "context_record_id": {"type": "string", "minLength": 1},
        "context_version_id": {"type": "string", "minLength": 1},
        "version": {"type": "string"},
        "origin_event_id": {"type": "string", "minLength": 1},
        "source_event_id": {"type": "string", "minLength": 1},
        "domain": {"type": "string"},
        "context_owner_id": {"type": "string", "minLength": 1},
        "observed_at": {"type": "string", "format": "date-time"},
        "ingested_at": {"type": "string", "format": "date-time"},
        "effective_from": {"type": "string", "format": "date-time"},
        "effective_to": {"type": ["string", "null"], "format": "date-time"},
        "context_schema_version": {"const": "context-record/1.0.0"},
        "source_version": {"type": "string"},
        "provenance_method": {"type": "string"},
        "prov_was_derived_from": {"type": "string"},
        "business_purpose": {"type": "string"},
        "purpose_owner": {"type": "string"},
        "processing_location": {"type": ["string", "null"]},
        "data_subject_location": {"type": ["string", "null"]},
        "jurisdiction": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "candidate_obligations": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "applicability_basis": {"type": "string"},
        "applicability_status": {"type": "string", "enum": ["candidate", "not_asserted", "review_required"]},
        "mapping_refs": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["mapping_id", "version"]}},
        "source_confidence": {"oneOf": [{"type": "number", "minimum": 0, "maximum": 1}, {"const": "unknown"}]},
        "transformation_confidence": {"type": "string", "enum": ["deterministic", "inferred", "unknown"]},
        "uncertainty_type": {"type": "string", "enum": ["missing", "conflict", "unvalidated", "none"]},
        "uncertainty_note": {"type": "string"},
        "missing_context_fields": {"type": "array", "items": {"type": "string"}},
        "validation_status": {"type": "string", "enum": ["inferred", "review_required", "human_confirmed", "rejected", "deferred", "expired"]},
        "validation_actor": {"type": ["string", "null"]},
        "validation_time": {"type": ["string", "null"], "format": "date-time"},
        "conflict": {"type": "boolean"},
        "conflict_assertions": {"type": "array"},
        "supersedes": {"type": ["string", "null"]}
      }
    },
    "mapping_record": {
      "type": "object",
      "required": ["artefact_id", "mapping_type", "source_concept", "target_concept", "owner", "author", "rationale", "evidence_reference", "version", "status", "approved_by", "approved_at", "effective_from", "effective_to", "supersedes", "checksum"],
      "properties": {
        "artefact_id": {"type": "string"},
        "mapping_type": {"type": "string"},
        "source_concept": {"type": "string"},
        "target_concept": {"type": "string"},
        "owner": {"type": "string"},
        "author": {"type": "string"},
        "rationale": {"type": "string"},
        "evidence_reference": {"type": "string"},
        "version": {"type": "string"},
        "status": {"type": "string", "enum": ["draft", "active", "superseded", "retired"]},
        "approved_by": {"type": ["string", "null"]},
        "approved_at": {"type": ["string", "null"], "format": "date-time"},
        "effective_from": {"type": "string", "format": "date-time"},
        "effective_to": {"type": ["string", "null"], "format": "date-time"},
        "supersedes": {"type": ["string", "null"]},
        "checksum": {"type": "string"}
      }
    },
    "assessment_output": {
      "type": "object",
      "required": ["assessment_id", "risk_id", "origin_event_id", "context_version_ids", "mapping_version_ids", "criteria_set_version", "risk_model_version", "prompt_version", "model_identifier", "generated_at", "validation_status", "confidence", "uncertainty", "explanation", "evidence", "review_status", "assessment_manifest"],
      "properties": {
        "assessment_id": {"type": "string"},
        "risk_id": {"type": "string"},
        "origin_event_id": {"type": "string"},
        "context_version_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "mapping_version_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "criteria_set_version": {"type": "string"},
        "risk_model_version": {"type": "string"},
        "prompt_version": {"type": "string"},
        "model_identifier": {"type": "string"},
        "generated_at": {"type": "string", "format": "date-time"},
        "validation_status": {"const": "human_confirmed"},
        "confidence": {"oneOf": [{"type": "number", "minimum": 0, "maximum": 1}, {"enum": ["unknown", "bounded"]}]},
        "uncertainty": {"type": "string"},
        "explanation": {"type": "string"},
        "evidence": {"type": "object"},
        "review_status": {"type": "string"},
        "assessment_manifest": {"type": "object"}
      }
    },
    "review_decision": {
      "type": "object",
      "required": ["review_id", "origin_event_id", "risk_id", "assessment_id", "revision_id", "input_version", "output_version", "reviewer_role", "reviewer_id", "decision", "rationale", "timestamp", "application_status"],
      "properties": {
        "review_id": {"type": "string"},
        "origin_event_id": {"type": "string"},
        "risk_id": {"type": "string"},
        "assessment_id": {"type": "string"},
        "revision_id": {"type": "string"},
        "input_version": {"type": "string"},
        "output_version": {"type": "string"},
        "reviewer_role": {"const": "reviewer"},
        "reviewer_id": {"type": "string"},
        "decision": {"type": "string", "enum": ["Approve", "Reject", "Defer"]},
        "rationale": {"type": "string", "minLength": 1},
        "timestamp": {"type": "string", "format": "date-time"},
        "application_status": {"type": "string", "enum": ["not_applied", "applied", "rolled_back"]}
      }
    }
  }
}
