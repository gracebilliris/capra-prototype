# CAPRA reviewer route — environment template.
#
# reviewer/scripts/bootstrap.sh copies this file to reviewer/.env on first run
# and adds any key that a later revision introduced. reviewer/.env is
# git-ignored and is the ONLY place your endpoint values are stored. This
# template is committed, so every value below is an unmistakable placeholder.
# Never put a real base URL, key, or account name in this file.

# ---------------------------------------------------------------------------
# Language model provider
# ---------------------------------------------------------------------------
# openai-compatible : PREFERRED. Any endpoint that speaks the OpenAI
#                     chat-completions API. You supply the base URL, the key,
#                     and the model name. CAPRA is not tied to any vendor,
#                     and the route is not Azure-specific.
# ollama            : OPTIONAL FALLBACK. A local Ollama runtime. No key, no
#                     account, no cost. Model quality varies sharply; see
#                     reviewer/QUICKSTART.md before relying on it.
CAPRA_LLM_PROVIDER=openai-compatible

# Replace all three. The bootstrap refuses to claim the endpoint works while
# any of them still reads as a placeholder.
OPENAI_COMPATIBLE_BASE_URL=https://replace.example/v1
OPENAI_COMPATIBLE_API_KEY=replace-with-your-key
OPENAI_COMPATIBLE_MODEL=replace-with-your-model-name

# Used only when CAPRA_LLM_PROVIDER=ollama.
CAPRA_OLLAMA_MODEL=llama3.2

# Set to 1 by the bootstrap once a live call to the endpoint has succeeded, and
# to 0 otherwise. verify_route.sh reads it so that an unverified endpoint is
# never reported as healthy.
CAPRA_ENDPOINT_VERIFIED=0

# ---------------------------------------------------------------------------
# Local stack
# ---------------------------------------------------------------------------
# Generated locally by the bootstrap. Not a shared secret: it encrypts only
# your own n8n credential store on your own machine.
N8N_ENCRYPTION_KEY=

# Ports are offset from the reference stack in docs/docker-compose.yml so both
# can coexist. Change any that clash on your machine, then re-run the bootstrap.
CAPRA_N8N_PORT=5679
CAPRA_MONGO_PORT=27019
CAPRA_FUSEKI_PORT=3031
CAPRA_OLLAMA_PORT=11435
CAPRA_LOKI_PORT=3101
CAPRA_GRAFANA_PORT=3002

# The released docs/docker-compose.yml pinned n8n 1.108.0, which predates the
# node type versions in the released workflow export. 2.6.4 resolves all of them.
CAPRA_N8N_IMAGE=n8nio/n8n:2.6.4

# Cap concurrent production executions so a slow stage cannot queue faster than
# it drains, and so a metered endpoint is not hit in parallel bursts.
CAPRA_CONCURRENCY=5
